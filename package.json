{
  "name": "cmdrop",
  "version": "0.1.0",
  "description": "AirDrop for shell commands — send a command to a nearby machine over the LAN.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "cmdrop": "./dist/cli.js",
    "cmdrop-daemon": "./dist/daemon.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "airdrop",
    "commands",
    "mdns",
    "lan",
    "pairing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/selfsigned": "^2.0.4",
    "typescript": "^5.7.2"
  }
}
